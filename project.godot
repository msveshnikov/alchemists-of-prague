; Engine configuration file.
; Alchemists of Prague — vertical slice (Old Town Square)

config_version=5

[application]

config/name="Alchemists of Prague"
config/description="Action-RPG in medieval Prague: Old Town Square vertical slice."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icons/sword_1.png"

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/default_gravity=9.8
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/size.web=2048

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.45, 0.55, 0.7, 1)
textures/default_filters/anisotropic_filtering_level=3
